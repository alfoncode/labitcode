---
import Badge from "@/components/Badge.astro";
import { formatCardDate, getCardReadingTime } from "@/utils/helpers";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  author: string;
  slug: string;
  body?: string;
  heroImage?: string;
  lang?: "en" | "es";
  href?: string;
}

const {
  title,
  description,
  pubDate,
  tags,
  author,
  slug,
  body = "",
  heroImage,
  lang = "en",
  href,
} = Astro.props;

const postUrl = href || (lang === "es" ? `/es/blog/${slug}` : `/blog/${slug}`);
const readingTime = getCardReadingTime(body);
const authorInitials = author === "AI" ? "AI" : "AG";
---

<article
  class="group relative rounded-2xl border border-border dark:border-navy-light bg-surface dark:bg-navy-light/50 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5 overflow-hidden flex flex-col h-full"
>
  <a href={postUrl} class="absolute inset-0 z-10" aria-label={`Read "${title}"`}></a>

  {/* Hero Image */}
  {
    heroImage && (
      <div class="aspect-video w-full overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
        />
      </div>
    )
  }

  <div class="p-6 flex flex-col flex-1">
    {/* Tags */}
    <div class="flex items-center gap-2 mb-3 overflow-hidden whitespace-nowrap">
      {
        tags.slice(0, 3).map((tag) => (
          <a
            href={
              lang === "es"
                ? `/es/blog/tag/${encodeURIComponent(tag)}`
                : `/blog/tag/${encodeURIComponent(tag)}`
            }
            class="relative z-20 shrink-0"
            aria-label={
              lang === "es"
                ? `Ver más artículos con la etiqueta ${tag}`
                : `See more articles tagged ${tag}`
            }
          >
            <Badge label={tag} variant="accent" />
          </a>
        ))
      }
    </div>

    {/* Title */}
    <h3
      class="text-lg font-bold text-navy dark:text-gray-100 group-hover:text-accent transition-colors duration-200 line-clamp-2 mb-2"
    >
      {title}
    </h3>

    {/* Description */}
    <p class="text-sm text-gray-700 dark:text-gray-500 line-clamp-3 mb-4 leading-relaxed flex-1">
      {description}
    </p>

    {/* Meta Footer */}
    <div
      class="pt-3.5 mt-auto border-t border-border/60 dark:border-navy-light/60 flex items-center justify-between text-xs text-gray-500 gap-2"
    >
      <div class="flex items-center gap-1.5 min-w-0">
        <span
          class="w-5 h-5 rounded-full bg-accent/10 text-accent text-[10px] font-bold inline-flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          {authorInitials}
        </span>
        <span class="font-medium text-navy dark:text-gray-200 truncate">{author}</span>
        <span class="text-gray-300 dark:text-gray-600 shrink-0">·</span>
        <time datetime={pubDate.toISOString()} class="shrink-0 text-gray-500 dark:text-gray-400">
          {formatCardDate(pubDate, lang)}
        </time>
      </div>
      <span class="flex items-center gap-1 font-medium text-gray-500 dark:text-gray-400 shrink-0">
        <svg
          class="w-3.5 h-3.5 text-gray-400"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {readingTime}
      </span>
    </div>
  </div>
</article>
