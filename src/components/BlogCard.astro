---
import Badge from "@/components/Badge.astro";
import { formatDate, getReadingTime } from "@/utils/helpers";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  author: string;
  slug: string;
  body?: string;
  heroImage?: string;
}

const { title, description, pubDate, tags, author, slug, body, heroImage } =
  Astro.props;
const readingTime = body ? getReadingTime(body) : "3 min read";
---

<article
  class="group relative rounded-2xl border border-border dark:border-navy-light bg-surface dark:bg-navy-light/50 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5 overflow-hidden flex flex-col h-full"
>
  <a
    href={`/blog/${slug}`}
    class="absolute inset-0 z-10"
    aria-label={`Read "${title}"`}></a>

  {/* Hero Image */}
  {
    heroImage && (
      <div class="aspect-video w-full overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
        />
      </div>
    )
  }

  <div class="p-6 flex flex-col flex-1">
    {/* Tags */}
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.slice(0, 3).map((tag) => <Badge label={tag} variant="accent" />)}
    </div>

    {/* Title */}
    <h3
      class="text-lg font-bold text-navy dark:text-gray-100 group-hover:text-accent transition-colors duration-200 line-clamp-2 mb-2"
    >
      {title}
    </h3>

    {/* Description */}
    <p
      class="text-sm text-gray-700 dark:text-gray-500 line-clamp-3 mb-4 leading-relaxed flex-1"
    >
      {description}
    </p>

    {/* Meta */}
    <div class="flex items-center justify-between text-xs text-gray-500">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <svg
            class="w-3.5 h-3.5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
              x1="16"
              y1="2"
              x2="16"
              y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
              x1="3"
              y1="10"
              x2="21"
              y2="10"></line>
          </svg>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        <span class="flex items-center gap-1">
          <svg
            class="w-3.5 h-3.5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle><polyline
              points="12 6 12 12 16 14"></polyline>
          </svg>
          {readingTime}
        </span>
      </div>
      <span class="font-medium">{author}</span>
    </div>
  </div>
</article>
