---
// Search modal — rendered on every page, controlled via vanilla JS
---

<div
  id="search-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-navy/60 dark:bg-black/70 backdrop-blur-sm">
  </div>

  <!-- Modal -->
  <div class="relative flex items-start justify-center pt-[15vh] px-4">
    <div
      class="w-full max-w-lg bg-surface dark:bg-navy-light rounded-2xl shadow-2xl border border-border dark:border-navy-light overflow-hidden animate-fade-in"
    >
      <!-- Input -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-border dark:border-navy-light">
        <svg
          class="w-5 h-5 text-gray-500 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="search-input"
          type="text"
          class="flex-1 bg-transparent text-navy dark:text-gray-100 placeholder-gray-500 outline-none text-sm"
          placeholder="Search posts, projects, tags…"
          autocomplete="off"
        />
        <kbd
          class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-xs text-gray-500 border border-border dark:border-navy-light rounded font-mono"
        >
          ESC
        </kbd>
      </div>

      <!-- Results -->
      <div id="search-results" class="max-h-80 overflow-y-auto p-2">
        <div id="search-empty" class="py-8 text-center text-sm text-gray-500">
          Start typing to search…
        </div>
        <div id="search-no-results" class="py-8 text-center text-sm text-gray-500 hidden">
          No results found.
        </div>
        <ul id="search-list" class="space-y-1 hidden"></ul>
      </div>
    </div>
  </div>
</div>

<script>
  import { search, type SearchEntry } from "@/utils/search";

  let searchIndex: SearchEntry[] = [];
  let loaded = false;

  async function loadIndex(): Promise<void> {
    if (loaded) return;
    try {
      const res = await fetch("/search-index.json");
      searchIndex = await res.json();
      loaded = true;
    } catch {
      searchIndex = [];
    }
  }

  function renderResults(results: SearchEntry[], query: string): void {
    const listEl = document.getElementById("search-list")!;
    const emptyEl = document.getElementById("search-empty")!;
    const noResultsEl = document.getElementById("search-no-results")!;
    const isEs = document.documentElement.lang === "es";

    if (!query.trim()) {
      listEl.classList.add("hidden");
      noResultsEl.classList.add("hidden");
      emptyEl.textContent = isEs ? "Escribe para buscar…" : "Start typing to search…";
      emptyEl.classList.remove("hidden");
      return;
    }

    if (results.length === 0) {
      listEl.classList.add("hidden");
      emptyEl.classList.add("hidden");
      noResultsEl.textContent = isEs ? "No se encontraron resultados." : "No results found.";
      noResultsEl.classList.remove("hidden");
      return;
    }

    emptyEl.classList.add("hidden");
    noResultsEl.classList.add("hidden");
    listEl.classList.remove("hidden");

    listEl.innerHTML = results
      .map((entry) => {
        const prefix = entry.lang === "es" ? "/es" : "";
        const href =
          entry.type === "blog"
            ? `${prefix}/blog/${entry.slug}`
            : `${prefix}/projects/${entry.slug}`;
        const typeLabel =
          entry.type === "blog"
            ? entry.lang === "es"
              ? "Blog"
              : "Blog"
            : entry.lang === "es"
              ? "Proyecto"
              : "Project";
        const typeColor = entry.type === "blog" ? "text-accent" : "text-emerald-500";
        const langBadge = entry.lang === "es" ? "ES" : "EN";
        return `
          <li>
            <a href="${href}" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-navy transition-colors duration-150 group">
              <span class="mt-0.5 text-xs font-semibold ${typeColor} uppercase tracking-wider shrink-0">${typeLabel}</span>
              <span class="mt-0.5 text-[10px] font-bold px-1.5 py-0.5 rounded bg-gray-200 dark:bg-navy-light text-gray-600 dark:text-gray-300 shrink-0">${langBadge}</span>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-navy dark:text-gray-100 group-hover:text-accent transition-colors truncate">${entry.title}</p>
                <p class="text-xs text-gray-500 mt-0.5 truncate">${entry.description}</p>
              </div>
            </a>
          </li>
        `;
      })
      .join("");
  }

  function openSearch(): void {
    const modal = document.getElementById("search-modal")!;
    const input = document.getElementById("search-input") as HTMLInputElement;
    const isEs = document.documentElement.lang === "es";
    if (input) {
      input.placeholder = isEs
        ? "Buscar artículos, proyectos, etiquetas…"
        : "Search posts, projects, tags…";
    }
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    loadIndex();
    setTimeout(() => input.focus(), 50);
  }

  function closeSearch(): void {
    const modal = document.getElementById("search-modal")!;
    const input = document.getElementById("search-input") as HTMLInputElement;
    modal.classList.add("hidden");
    document.body.style.overflow = "";
    input.value = "";
    renderResults([], "");
  }

  function initSearch(): void {
    const trigger = document.getElementById("search-trigger");
    const backdrop = document.getElementById("search-backdrop");
    const input = document.getElementById("search-input") as HTMLInputElement;

    const resultsContainer = document.getElementById("search-results");
    resultsContainer?.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement)?.closest("a");
      if (link) {
        closeSearch();
      }
    });

    trigger?.addEventListener("click", openSearch);
    backdrop?.addEventListener("click", closeSearch);

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        const modal = document.getElementById("search-modal")!;
        modal.classList.contains("hidden") ? openSearch() : closeSearch();
      }
      if (e.key === "Escape") closeSearch();
    });

    input?.addEventListener("input", () => {
      const q = input.value;
      const currentLang = document.documentElement.lang === "es" ? "es" : "en";
      const results = search(searchIndex, q, currentLang);
      renderResults(results, q);
    });
  }

  initSearch();
  document.addEventListener("astro:before-swap", closeSearch);
  document.addEventListener("astro:after-swap", () => {
    document.body.style.overflow = "";
    initSearch();
  });
</script>
