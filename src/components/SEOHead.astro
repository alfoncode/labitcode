---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article" | "profile";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  tags?: string[];
  section?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-default.png",
  type = "website",
  publishedDate,
  modifiedDate,
  author,
  tags,
  section,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const siteName = "Labitcode";
const fullTitle = title === "Home" ? `${siteName} — Engineering Lab` : `${title} | ${siteName}`;
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Build the Organization JSON-LD (always present)
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "labitcode",
  url: "https://labitcode.com",
  logo: "https://labitcode.com/favicon.svg",
  description: "Engineering lab exploring Software, AI, Security, and DevOps.",
  founder: {
    "@type": "Person",
    name: "Alfonso Garcia",
  },
};

// Build the Person JSON-LD for the founder
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alfonso Garcia",
  url: "https://labitcode.com/team",
  jobTitle: "Software Engineer",
  worksFor: {
    "@type": "Organization",
    name: "labitcode",
  },
};

// Merge all JSON-LD: Organization is always included, plus page-specific
const allJsonLd = [organizationLd, personLd];
if (jsonLd) {
  allJsonLd.push(jsonLd);
}
---

<!-- Primary Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author || "Alfonso Garcia"} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

{tags && <meta name="keywords" content={tags.join(", ")} />}

<!-- Open Graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content={type} />
<meta property="og:locale" content="en_US" />
{publishedDate && <meta property="article:published_time" content={publishedDate} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{author && <meta property="article:author" content={author} />}
{section && <meta property="article:section" content={section} />}
{tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:site" content="@alfoncode" />

<!-- Preload fonts (non-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Mobile browser chrome -->
<meta name="theme-color" content="#0A1628" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- JSON-LD Structured Data -->
{allJsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
