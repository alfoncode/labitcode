---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article" | "profile";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = "/og-default.png",
  type = "website",
  publishedDate,
  modifiedDate,
  author,
  tags,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const siteName = "labitcode";
const fullTitle =
  title === "Home" ? `${siteName} — Engineering Lab` : `${title} | ${siteName}`;

// Build the Organization JSON-LD (always present)
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "labitcode",
  url: "https://labitcode.com",
  logo: "https://labitcode.com/logo.svg",
  description: "Engineering lab exploring Software, AI, Security, and DevOps.",
  founder: {
    "@type": "Person",
    name: "Alfonso Garcia",
  },
};

// Build the Person JSON-LD for the founder
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alfonso Garcia",
  url: "https://labitcode.com/team",
  jobTitle: "Software Engineer",
  worksFor: {
    "@type": "Organization",
    name: "labitcode",
  },
};

// Merge all JSON-LD: Organization is always included, plus page-specific
const allJsonLd = [organizationLd, personLd];
if (jsonLd) {
  allJsonLd.push(jsonLd);
}
---

<!-- Primary Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author || "Alfonso Garcia"} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

{tags && <meta name="keywords" content={tags.join(", ")} />}

<!-- Open Graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="en_US" />
{
  publishedDate && (
    <meta property="article:published_time" content={publishedDate} />
  )
}
{
  modifiedDate && (
    <meta property="article:modified_time" content={modifiedDate} />
  )
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Preload fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<!-- JSON-LD Structured Data -->
{
  allJsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))
}
