---
// SearchBar.astro — Reusable inline search input for blog/projects pages.
// Renders a search icon, text input, and clear button. The parent page
// wires the JS filtering logic — this component provides the DOM structure.
interface Props {
  placeholder?: string;
  inputId?: string;
}

const { placeholder = "Search...", inputId = "inline-search" } = Astro.props;
---

<div class="search-bar-wrapper mb-8">
  <div class="relative">
    <!-- Search icon -->
    <svg
      class="absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500 pointer-events-none"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>

    <!-- Input -->
    <input
      id={inputId}
      type="text"
      class="search-input w-full pl-10 pr-10 py-3 rounded-xl border border-border dark:border-navy-light bg-surface dark:bg-navy-light text-navy dark:text-gray-100 placeholder:text-gray-500 text-sm outline-none transition-all duration-200 focus:border-accent focus:ring-2 focus:ring-accent/10"
      placeholder={placeholder}
      autocomplete="off"
    />

    <!-- Clear button -->
    <button
      id={`${inputId}-clear`}
      class="search-clear hidden absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center rounded-full text-gray-500 hover:text-accent hover:bg-accent/5 transition-colors duration-150"
      type="button"
      aria-label="Clear search"
    >
      <svg
        class="w-3.5 h-3.5"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>
</div>
