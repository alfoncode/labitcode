---
interface Props {
  label: string;
  variant?: 'default' | 'accent' | 'outline';
  size?: 'sm' | 'md';
}

const { label, variant = 'default', size = 'sm' } = Astro.props;

const baseClasses = 'inline-flex items-center font-medium rounded-full transition-colors duration-200';

const sizeClasses = {
  sm: 'px-2.5 py-0.5 text-xs',
  md: 'px-3 py-1 text-sm',
};

const variantClasses = {
  default: 'bg-gray-100 text-gray-700 dark:bg-navy-light dark:text-gray-500',
  accent: 'bg-accent/10 text-accent',
  outline: 'border border-border dark:border-navy-light text-gray-700 dark:text-gray-500',
};
---

<span class:list={[baseClasses, sizeClasses[size], variantClasses[variant]]}>
  {label}
</span>
