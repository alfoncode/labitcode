---

---

<dialog
  id="image-lightbox-dialog"
  class="fixed inset-0 m-auto p-0 border-0 bg-transparent max-w-[92vw] max-h-[92vh] overflow-hidden outline-none backdrop:bg-navy/85 backdrop:backdrop-blur-md rounded-2xl shadow-2xl transition-all duration-300 open:animate-fade-in text-slate-100"
>
  <form
    method="dialog"
    class="relative flex flex-col items-center justify-center p-2 sm:p-4 overflow-hidden"
  >
    <!-- Close button -->
    <button
      type="submit"
      class="absolute top-2 right-2 sm:top-3 sm:right-3 w-9 h-9 rounded-full bg-navy/90 border border-slate-700 text-white flex items-center justify-center hover:bg-accent hover:border-accent transition-colors shadow-lg z-20 focus:outline-none focus:ring-2 focus:ring-accent"
      aria-label="Close image popup"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Expanded Image -->
    <div
      class="relative max-w-full max-h-[80vh] overflow-hidden rounded-xl bg-slate-950 flex items-center justify-center border border-slate-800"
    >
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[80vh] object-contain rounded-xl select-none"
      />
    </div>

    <!-- Caption -->
    <figcaption
      id="lightbox-caption"
      class="mt-3 text-center text-sm font-medium text-slate-300 max-w-2xl px-4 line-clamp-2"
    >
    </figcaption>
  </form>
</dialog>

<style>
  dialog#image-lightbox-dialog {
    overflow: hidden !important;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  dialog#image-lightbox-dialog::-webkit-scrollbar {
    display: none;
  }

  dialog#image-lightbox-dialog::backdrop {
    background-color: rgba(2, 6, 23, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* Zoom cursor hint for content images */
  :global(.prose img),
  :global(.aspect-video img) {
    cursor: zoom-in;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  :global(.prose img:hover),
  :global(.aspect-video img:hover) {
    opacity: 0.95;
  }
</style>

<script>
  function initImageLightbox(): void {
    const dialog = document.getElementById("image-lightbox-dialog") as HTMLDialogElement | null;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const lightboxCaption = document.getElementById("lightbox-caption") as HTMLElement | null;

    if (!dialog || !lightboxImg || !lightboxCaption) return;

    // Handle scroll locking on dialog close
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    // Attach click handlers to all article and component images inside prose or aspect-video containers
    const images = document.querySelectorAll<HTMLImageElement>(".prose img, .aspect-video img");

    images.forEach((img) => {
      if (img.dataset.lightboxBound) return;
      img.dataset.lightboxBound = "true";

      img.addEventListener("click", (e) => {
        e.preventDefault();
        const src = img.getAttribute("src") || img.currentSrc;
        const alt = img.getAttribute("alt") || "";

        if (!src) return;

        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightboxCaption.textContent = alt;

        document.body.style.overflow = "hidden";

        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        } else {
          dialog.setAttribute("open", "true");
        }
      });
    });

    // Light-dismiss fallback: clicking on the backdrop closes the dialog
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        const rect = dialog.getBoundingClientRect();
        const isInside =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;

        if (!isInside) {
          dialog.close();
        }
      }
    });
  }

  initImageLightbox();
  document.addEventListener("astro:after-swap", initImageLightbox);
</script>
