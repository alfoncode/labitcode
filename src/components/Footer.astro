---
const currentYear = new Date().getFullYear();
const navLinks = [
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/team", label: "Team" },
];
---

<footer class="relative mt-auto border-t border-border dark:border-navy-light overflow-hidden">
  <!-- Subtle gradient accent line at top -->
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Main footer content -->
    <div class="py-12 flex flex-col md:flex-row items-center md:items-start justify-between gap-10">
      <!-- Brand block -->
      <div class="flex flex-col items-center md:items-start gap-4 max-w-sm">
        <a href="/" class="flex items-center gap-2.5 group" aria-label="labitcode home">
          <!-- Flask icon (mini) -->
          <svg
            class="w-7 h-7 shrink-0"
            viewBox="0 0 512 512"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="footer-bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#0F172A"></stop>
                <stop offset="100%" stop-color="#0A1628"></stop>
              </linearGradient>
              <linearGradient id="footer-red" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#EF4444"></stop>
                <stop offset="100%" stop-color="#DC2626"></stop>
              </linearGradient>
              <clipPath id="footer-flask-clip">
                <path
                  d="M216 88 L216 190 L108 400 Q100 416 116 432 L396 432 Q412 416 404 400 L296 190 L296 88 Z"
                ></path>
              </clipPath>
            </defs>
            <rect width="512" height="512" rx="108" fill="url(#footer-bg)"></rect>
            <path
              d="M216 88 L216 190 L108 400 Q100 416 116 432 L396 432 Q412 416 404 400 L296 190 L296 88"
              stroke="#F1F5F9"
              stroke-width="22"
              stroke-linejoin="round"
              stroke-linecap="round"
              fill="none"></path>
            <line
              x1="194"
              y1="88"
              x2="318"
              y2="88"
              stroke="#F1F5F9"
              stroke-width="22"
              stroke-linecap="round"></line>
            <g clip-path="url(#footer-flask-clip)">
              <rect x="100" y="320" width="312" height="120" fill="url(#footer-red)" opacity="0.25"
              ></rect>
            </g>
            <path
              d="M220 310 L185 350 L220 390"
              stroke="url(#footer-red)"
              stroke-width="20"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"></path>
            <path
              d="M292 310 L327 350 L292 390"
              stroke="url(#footer-red)"
              stroke-width="20"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"></path>
            <line
              x1="244"
              y1="385"
              x2="268"
              y2="315"
              stroke="#EF4444"
              stroke-width="18"
              stroke-linecap="round"></line>
            <circle cx="235" cy="265" r="9" fill="#EF4444" opacity="0.5"></circle>
            <circle cx="275" cy="238" r="6" fill="#EF4444" opacity="0.4"></circle>
          </svg>
          <span class="text-base font-extrabold tracking-tight text-navy dark:text-gray-100">
            <span class="text-gray-400 dark:text-gray-500 font-bold">&lt;</span>labitcode<span
              class="text-accent font-bold">/</span
            ><span class="text-gray-400 dark:text-gray-500 font-bold">&gt;</span>
          </span>
        </a>
        <p
          class="text-sm text-gray-600 dark:text-gray-500 leading-relaxed text-center md:text-left"
        >
          Engineering and innovation laboratory.
        </p>
      </div>

      <!-- Navigation + Social -->
      <div class="flex flex-col items-center md:items-end gap-6">
        <!-- Nav links as pills -->
        <nav class="flex flex-wrap justify-center gap-2" aria-label="Footer navigation">
          {
            navLinks.map(({ href, label }) => (
              <a
                href={href}
                class="px-4 py-2 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-400 hover:text-accent hover:bg-accent/5 transition-all duration-200"
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="border-t border-border dark:border-navy-light py-6 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-xs text-gray-500 dark:text-gray-400">
        &copy; {currentYear} labitcode. All rights reserved.
      </p>
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Built with
        <svg
          class="inline w-3.5 h-3.5 -mt-0.5 text-accent"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
        by Alfonso &amp; AI
      </p>
    </div>
  </div>
</footer>
