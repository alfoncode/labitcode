---
import SEOHead from "@/components/SEOHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Search from "@/components/Search.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  tags?: string[];
  section?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  includeOrganization?: boolean;
  includeWebSite?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  canonicalOverride?: string;
  lang?: "en" | "es";
  alternateUrls?: { en?: string; es?: string };
}

const props = Astro.props;
const currentPath = Astro.url.pathname;
const isSpanish = props.lang === "es" || currentPath === "/es" || currentPath.startsWith("/es/");
const effectiveLang: "en" | "es" = props.lang ?? (isSpanish ? "es" : "en");
const alternateUrl = effectiveLang === "es" ? props.alternateUrls?.en : props.alternateUrls?.es;

function toRelativePath(url?: string): string {
  if (!url) return "";
  try {
    return new URL(url, "https://labitcode.com").pathname;
  } catch {
    return url.replace(/^https?:\/\/[^/]+/, "") || "/";
  }
}

const esUrl =
  effectiveLang === "es"
    ? currentPath
    : toRelativePath(props.alternateUrls?.es) ||
      (currentPath === "/" ? "/es" : `/es${currentPath}`);
const enUrl =
  effectiveLang === "en"
    ? currentPath
    : toRelativePath(props.alternateUrls?.en) || currentPath.replace(/^\/es(?:\/|$)/, "/") || "/";
---

<!doctype html>
<html lang={effectiveLang}>
  <head>
    <!-- Anti-FOUC: set theme before paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.setAttribute("data-theme", stored || preferred);
      })();
      document.addEventListener("astro:after-swap", function () {
        const stored = localStorage.getItem("theme");
        const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.setAttribute("data-theme", stored || preferred);
      });
    </script>

    <!-- Browser language detection & preferred language auto-redirect -->
    <script is:inline define:vars={{ effectiveLang, esUrl, enUrl }}>
      (function () {
        try {
          if (
            navigator.userAgent &&
            /bot|googlebot|bingbot|crawler|spider|slurp|duckduckbot/i.test(navigator.userAgent)
          ) {
            return;
          }

          var pref = localStorage.getItem("preferred-lang");
          var langs = navigator.languages || [navigator.language || ""];
          var isBrowserEs = false;

          for (var i = 0; i < langs.length; i++) {
            var l = (langs[i] || "").toLowerCase();
            if (l.startsWith("es")) {
              isBrowserEs = true;
              break;
            }
            if (l.startsWith("en")) {
              isBrowserEs = false;
              break;
            }
          }

          // Case 1: Visitor prefers Spanish (explicitly or via browser default with no preference)
          if ((pref === "es" || (!pref && isBrowserEs)) && effectiveLang === "en") {
            if (esUrl && esUrl !== window.location.pathname) {
              window.location.replace(esUrl + window.location.search + window.location.hash);
              return;
            }
          }

          // Case 2: Visitor explicitly prefers English (clicked EN) but landed on a Spanish page
          if (pref === "en" && effectiveLang === "es") {
            if (enUrl && enUrl !== window.location.pathname) {
              window.location.replace(enUrl + window.location.search + window.location.hash);
              return;
            }
          }
        } catch (e) {
          // Ignore errors in sandboxed/restricted environments
        }
      })();

      // Event delegation: persist user preference on clicking any language switch element
      document.addEventListener("click", function (e) {
        var el = e.target && e.target.closest ? e.target.closest("[data-target-lang]") : null;
        if (el) {
          var targetLang = el.getAttribute("data-target-lang");
          if (targetLang) {
            localStorage.setItem("preferred-lang", targetLang);
            document.cookie =
              "preferred-lang=" + targetLang + "; path=/; max-age=31536000; SameSite=Lax";
          }
        }
      });
    </script>

    <SEOHead {...props} lang={effectiveLang} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={effectiveLang} alternateUrl={alternateUrl} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={effectiveLang} />
    <Search />
    <ImageLightbox />
    <SpeedInsights />
  </body>
</html>
