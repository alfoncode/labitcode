---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchBar from "@/components/SearchBar.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";

const ITEMS_PER_PAGE = 6;

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.lastUpdated.valueOf() - a.data.lastUpdated.valueOf(),
);
---

<BaseLayout
  title="Projects"
  description="The Lab — Side projects and experiments from labitcode, exploring new technologies and engineering patterns."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy dark:text-gray-100 tracking-tight">
        The Lab
      </h1>
      <p class="mt-2 text-gray-500 max-w-2xl">
        Side projects, experiments, and tools built to explore new ideas and push the boundaries of
        modern engineering.
      </p>
    </div>

    <!-- Search Bar -->
    <SearchBar
      placeholder="Search projects by title, description, or tech stack…"
      inputId="projects-search"
    />

    <!-- Results count -->
    <p id="results-count" class="text-sm text-gray-500 mb-4">
      Showing {Math.min(ITEMS_PER_PAGE, allProjects.length)} of {allProjects.length} projects
    </p>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {
        allProjects.map((project, i) => {
          const searchText =
            `${project.data.title} ${project.data.description} ${project.data.stack.join(" ")}`.toLowerCase();
          return (
            <div
              data-search-text={searchText}
              class:list={[
                "project-card h-full transition-all duration-300",
                { hidden: i >= ITEMS_PER_PAGE },
              ]}
            >
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                stack={project.data.stack}
                status={project.data.status}
                lastUpdated={project.data.lastUpdated}
                creator={project.data.creator}
                slug={project.id}
                url={project.data.url}
                repo={project.data.repo}
                heroImage={project.data.heroImage}
              />
            </div>
          );
        })
      }
    </div>

    <!-- Empty state -->
    <div id="no-projects" class="hidden py-16 text-center text-gray-500">
      <svg
        class="w-12 h-12 mx-auto mb-4 text-gray-500"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <p class="text-lg font-medium">No projects found</p>
      <p class="mt-1 text-gray-500">Try adjusting your search terms.</p>
    </div>

    <!-- Infinite scroll sentinel -->
    <div id="scroll-sentinel" class="flex items-center justify-center py-8">
      <div id="scroll-spinner" class="hidden">
        <div class="scroll-spinner"></div>
      </div>
      <p id="scroll-end" class="hidden text-sm text-gray-500">You've reached the end.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const ITEMS_PER_PAGE = 6;

  let searchQuery = "";
  let visibleCount = ITEMS_PER_PAGE;

  const grid = document.getElementById("projects-grid")!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>(".project-card"));
  const searchInput = document.getElementById("projects-search") as HTMLInputElement;
  const clearBtn = document.getElementById("projects-search-clear")!;
  const noProjectsEl = document.getElementById("no-projects")!;
  const sentinel = document.getElementById("scroll-sentinel")!;
  const spinner = document.getElementById("scroll-spinner")!;
  const endMsg = document.getElementById("scroll-end")!;
  const resultsCount = document.getElementById("results-count")!;

  // ── Filtering ──────────────────────────────────────────────────

  function cardMatchesSearch(card: HTMLElement): boolean {
    if (!searchQuery.trim()) return true;
    const text = card.dataset.searchText || "";
    return text.includes(searchQuery.toLowerCase().trim());
  }

  // ── Visibility update ──────────────────────────────────────────

  function updateVisibility(): void {
    let matchCount = 0;
    let shownCount = 0;

    cards.forEach((card) => {
      if (cardMatchesSearch(card)) {
        matchCount++;
        if (shownCount < visibleCount) {
          card.classList.remove("hidden");
          shownCount++;
        } else {
          card.classList.add("hidden");
        }
      } else {
        card.classList.add("hidden");
      }
    });

    // Update results count
    resultsCount.textContent = `Showing ${shownCount} of ${matchCount} projects`;

    // Show/hide empty state
    noProjectsEl.classList.toggle("hidden", matchCount > 0);

    // Show/hide sentinel states
    const hasMore = shownCount < matchCount;
    spinner.classList.toggle("hidden", !hasMore);
    endMsg.classList.toggle("hidden", hasMore || matchCount === 0);

    // Hide sentinel entirely when there are 0 matches
    sentinel.classList.toggle("hidden", matchCount === 0);
  }

  // ── Load more ──────────────────────────────────────────────────

  function loadMore(): void {
    visibleCount += ITEMS_PER_PAGE;
    updateVisibility();
  }

  // ── Intersection Observer ──────────────────────────────────────

  let observer: IntersectionObserver | null = null;

  function setupObserver(): void {
    if (observer) observer.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          loadMore();
        }
      },
      { rootMargin: "200px" },
    );
    observer.observe(sentinel);
  }

  // ── Search handlers ────────────────────────────────────────────

  let searchDebounce: ReturnType<typeof setTimeout>;

  function onSearchInput(): void {
    const hasValue = searchInput.value.trim().length > 0;
    clearBtn.classList.toggle("hidden", !hasValue);

    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => {
      searchQuery = searchInput.value;
      visibleCount = ITEMS_PER_PAGE;
      updateVisibility();
    }, 200);
  }

  searchInput.addEventListener("input", onSearchInput);
  searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      searchInput.value = "";
      onSearchInput();
      searchInput.blur();
    }
  });

  clearBtn.addEventListener("click", () => {
    searchInput.value = "";
    onSearchInput();
    searchInput.focus();
  });

  // ── Init ───────────────────────────────────────────────────────

  function init(): void {
    setupObserver();
    updateVisibility();
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
