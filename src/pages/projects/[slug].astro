---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/Badge.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "@/utils/helpers";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusColors: Record<string, string> = {
  active: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
  "in-progress": "bg-amber-500/10 text-amber-600 dark:text-amber-400",
  archived: "bg-gray-500/10 text-gray-500",
};

// JSON-LD for SoftwareApplication
const softwareAppLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.data.title,
  description: project.data.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  author: {
    "@type": "Person",
    name: project.data.creator,
  },
  ...(project.data.url && { url: project.data.url }),
  ...(project.data.repo && {
    codeRepository: project.data.repo,
  }),
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  jsonLd={softwareAppLd}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-accent transition-colors mb-8"
    >
      <svg
        class="w-4 h-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
      >
      Back to Projects
    </a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div
          class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent shrink-0"
        >
          <svg
            class="w-6 h-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
            ></path>
          </svg>
        </div>
        <span
          class:list={[
            "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium",
            statusColors[project.data.status] || statusColors.active,
          ]}
        >
          {project.data.status}
        </span>
      </div>

      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy dark:text-gray-100 tracking-tight leading-[1.15] mb-4"
      >
        {project.data.title}
      </h1>

      <p class="text-lg text-gray-500 mb-6 max-w-none">
        {project.data.description}
      </p>

      <!-- Stack -->
      <div class="flex flex-wrap gap-2 mb-6">
        {
          project.data.stack.map((tech: string) => (
            <Badge label={tech} variant="outline" size="md" />
          ))
        }
      </div>

      <!-- Meta + Links -->
      <div
        class="flex flex-wrap items-center gap-4 text-sm text-gray-500 border-t border-border dark:border-navy-light pt-4"
      >
        <span
          >By <strong class="text-navy dark:text-gray-100"
            >{project.data.creator}</strong
          ></span
        >
        <span class="text-border dark:text-navy-light">·</span>
        <span>Updated {formatDate(project.data.lastUpdated)}</span>
        {
          project.data.url && (
            <>
              <span class="text-border dark:text-navy-light">·</span>
              <a
                href={project.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:text-accent-light transition-colors font-medium"
              >
                Live Site ↗
              </a>
            </>
          )
        }
        {
          project.data.repo && (
            <>
              <span class="text-border dark:text-navy-light">·</span>
              <a
                href={project.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:text-accent-light transition-colors font-medium"
              >
                Source Code ↗
              </a>
            </>
          )
        }
      </div>
    </header>

    {/* Hero Image */}
    {
      project.data.heroImage && (
        <div class="mb-10 rounded-2xl overflow-hidden border border-border dark:border-navy-light aspect-video">
          <img
            src={project.data.heroImage}
            alt={project.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )
    }

    <!-- Content -->
    <div class="prose max-w-none">
      <Content />
    </div>

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-border dark:border-navy-light">
      <a
        href="/projects"
        class="text-sm font-medium text-accent hover:text-accent-light transition-colors flex items-center gap-1"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
        >
        All Projects
      </a>
    </footer>
  </article>
</BaseLayout>

<script>
  const LANG_LABELS: Record<string, string> = {
    typescript: "TypeScript",
    ts: "TypeScript",
    javascript: "JavaScript",
    js: "JavaScript",
    python: "Python",
    py: "Python",
    rust: "Rust",
    go: "Go",
    bash: "Bash",
    sh: "Shell",
    css: "CSS",
    html: "HTML",
    json: "JSON",
    yaml: "YAML",
    sql: "SQL",
    graphql: "GraphQL",
    markdown: "Markdown",
    md: "Markdown",
    tsx: "TSX",
    jsx: "JSX",
    astro: "Astro",
    svelte: "Svelte",
    dockerfile: "Dockerfile",
    toml: "TOML",
    xml: "XML",
  };

  function enhanceCodeBlocks(): void {
    const proseEls = document.querySelectorAll(".prose");
    proseEls.forEach((prose) => {
      const preBlocks = prose.querySelectorAll<HTMLPreElement>(":scope > pre");
      preBlocks.forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-block-wrapper")) return;

        const codeEl = pre.querySelector("code");
        const lang = pre.getAttribute("data-language") || "";
        const langLabel =
          LANG_LABELS[lang] ||
          (lang ? lang.charAt(0).toUpperCase() + lang.slice(1) : "Code");

        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper";

        const header = document.createElement("div");
        header.className = "code-block-header";

        const langSpan = document.createElement("span");
        langSpan.className = "code-lang";
        langSpan.textContent = langLabel;

        const copyBtn = document.createElement("button");
        copyBtn.className = "code-copy-btn";
        copyBtn.type = "button";
        copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg><span>Copy</span>`;

        copyBtn.addEventListener("click", async () => {
          const text = codeEl?.textContent || pre.textContent || "";
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add("copied");
            const label = copyBtn.querySelector("span")!;
            label.textContent = "Copied!";
            setTimeout(() => {
              copyBtn.classList.remove("copied");
              label.textContent = "Copy";
            }, 2000);
          } catch {
            /* clipboard API might fail in insecure context */
          }
        });

        header.appendChild(langSpan);
        header.appendChild(copyBtn);
        pre.parentNode!.insertBefore(wrapper, pre);
        wrapper.appendChild(header);
        wrapper.appendChild(pre);
      });
    });
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:after-swap", enhanceCodeBlocks);
</script>
