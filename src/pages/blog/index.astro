---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import Badge from '@/components/Badge.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Gather all unique tags
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="Blog"
  description="Engineering articles on Software, AI, Security, and DevOps from the labitcode team."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy dark:text-gray-100 tracking-tight">
        Engineering Hub
      </h1>
      <p class="mt-2 text-gray-500 max-w-2xl">
        Deep dives into Software Engineering, AI, Security, and DevOps — by humans and AI working together.
      </p>
    </div>

    <!-- Tag Filters -->
    <div class="flex flex-wrap gap-2 mb-10" id="tag-filters">
      <button
        data-tag="all"
        class="tag-btn px-3 py-1.5 rounded-full text-sm font-medium border border-accent bg-accent/10 text-accent transition-all duration-200"
      >
        All Posts
      </button>
      {allTags.map((tag) => (
        <button
          data-tag={tag}
          class="tag-btn px-3 py-1.5 rounded-full text-sm font-medium border border-border dark:border-navy-light text-gray-700 dark:text-gray-500 hover:border-accent hover:text-accent transition-all duration-200"
        >
          {tag}
        </button>
      ))}
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
      {allPosts.map((post) => (
        <div data-tags={JSON.stringify(post.data.tags)}>
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            author={post.data.author}
            slug={post.id}
            body={post.body}
          />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="no-posts" class="hidden py-16 text-center text-gray-500">
      No posts found for this tag.
    </div>
  </section>
</BaseLayout>

<script>
  function initTagFilter(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
    const cards = document.querySelectorAll<HTMLElement>('#posts-grid > div');
    const noPostsEl = document.getElementById('no-posts')!;

    const activeClasses = 'border-accent bg-accent/10 text-accent';
    const inactiveClasses = 'border-border dark:border-navy-light text-gray-700 dark:text-gray-500';

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag!;

        // Update button styles
        buttons.forEach((b) => {
          b.className = `tag-btn px-3 py-1.5 rounded-full text-sm font-medium border transition-all duration-200 ${inactiveClasses} hover:border-accent hover:text-accent`;
        });
        btn.className = `tag-btn px-3 py-1.5 rounded-full text-sm font-medium border transition-all duration-200 ${activeClasses}`;

        // Filter cards
        let visible = 0;
        cards.forEach((card) => {
          const tags: string[] = JSON.parse(card.dataset.tags || '[]');
          const show = tag === 'all' || tags.includes(tag);
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        noPostsEl.classList.toggle('hidden', visible > 0);
      });
    });
  }

  initTagFilter();
  document.addEventListener('astro:after-swap', initTagFilter);
</script>
