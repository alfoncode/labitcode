---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchBar from "@/components/SearchBar.astro";
import BlogCard from "@/components/BlogCard.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/consts";

const ITEMS_PER_PAGE = 6;

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.lang !== "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Gather all unique tags
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
const tagCounts = new Map(
  allTags.map((tag) => [tag, allPosts.filter((post) => post.data.tags.includes(tag)).length])
);
const popularTags = [...allTags]
  .sort((a, b) => (tagCounts.get(b) ?? 0) - (tagCounts.get(a) ?? 0) || a.localeCompare(b))
  .slice(0, 8);
const moreTags = allTags.filter((tag) => !popularTags.includes(tag));

// ItemList JSON-LD
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "labitcode Blog",
  url: `${SITE}/blog`,
  itemListElement: allPosts.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE}/blog/${p.id}`,
    name: p.data.title,
  })),
};
---

<BaseLayout
  title="Blog"
  description="Engineering articles on Software, AI, Security, and DevOps from the labitcode team."
  lang="en"
  alternateUrls={{ en: `${SITE}/blog`, es: `${SITE}/es/blog` }}
  jsonLd={itemListLd}
  breadcrumbs={[
    { name: "Home", url: SITE },
    { name: "Blog", url: `${SITE}/blog` },
  ]}
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy dark:text-gray-100 tracking-tight">
        Engineering Hub
      </h1>
      <p class="mt-2 max-w-2xl text-gray-600 dark:text-gray-300">
        Deep dives into Software Engineering, AI, Security, and DevOps — by humans and AI working
        together.
      </p>
    </div>

    <!-- Search Bar -->
    <SearchBar placeholder="Search posts by title, description, or tag…" inputId="blog-search" />

    <!-- Tag Filters -->
    <div
      class="flex flex-wrap gap-2 mb-10"
      id="tag-filters"
      role="group"
      aria-label="Filter posts by topic"
    >
      <button
        data-tag="all"
        aria-pressed="true"
        class="tag-btn px-3 py-1.5 rounded-full text-sm font-medium border border-accent bg-accent/10 text-accent transition-all duration-200"
      >
        All Posts
      </button>
      {
        popularTags.map((tag) => (
          <button
            data-tag={tag}
            aria-pressed="false"
            class="tag-btn px-3 py-1.5 rounded-full text-sm font-medium border border-border dark:border-navy-light text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent transition-all duration-200"
          >
            {tag}
          </button>
        ))
      }
      {
        moreTags.length > 0 && (
          <details class="basis-full mt-1">
            <summary class="w-fit cursor-pointer rounded-lg px-1 py-1 text-sm font-medium text-gray-600 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:text-gray-300">
              More topics ({moreTags.length})
            </summary>
            <div
              class="mt-3 flex max-h-40 flex-wrap gap-2 overflow-y-auto pr-1"
              role="region"
              aria-label="More topics"
              tabindex="0"
            >
              {moreTags.map((tag) => (
                <button
                  data-tag={tag}
                  aria-pressed="false"
                  class="tag-btn px-3 py-1.5 rounded-full text-sm font-medium border border-border dark:border-navy-light text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent transition-all duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          </details>
        )
      }
    </div>

    <!-- Results count -->
    <p
      id="results-count"
      class="mb-4 text-sm text-gray-600 dark:text-gray-300"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      Showing {Math.min(ITEMS_PER_PAGE, allPosts.length)} of {allPosts.length}
      {allPosts.length === 1 ? "post" : "posts"}
    </p>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
      {
        allPosts.map((post, i) => {
          const searchText =
            `${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`.toLowerCase();
          return (
            <div
              data-tags={JSON.stringify(post.data.tags)}
              data-search-text={searchText}
              class:list={[
                "post-card h-full transition-all duration-300",
                { hidden: i >= ITEMS_PER_PAGE },
              ]}
            >
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                author={post.data.author}
                slug={post.id}
                body={post.body}
                heroImage={post.data.heroImage}
              />
            </div>
          );
        })
      }
    </div>

    <!-- Empty state -->
    <div id="no-posts" class="hidden py-16 text-center text-gray-500">
      <svg
        class="w-12 h-12 mx-auto mb-4 text-gray-500"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <p class="text-lg font-medium text-navy dark:text-gray-100">No posts found</p>
      <p class="mt-1 text-gray-600 dark:text-gray-300">Try adjusting your search or tag filter.</p>
    </div>

    <!-- Infinite scroll sentinel with a keyboard-accessible fallback -->
    <div id="scroll-sentinel" class="flex flex-col items-center justify-center gap-3 py-8">
      <button
        id="load-more-posts"
        type="button"
        aria-controls="posts-grid"
        class="hidden rounded-xl border border-accent/40 bg-accent/5 px-5 py-2.5 text-sm font-semibold text-accent transition hover:bg-accent/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Load more posts
      </button>
      <p
        id="scroll-end"
        class="hidden text-sm text-gray-600 dark:text-gray-300"
        role="status"
        aria-live="polite"
      >
        You've reached the end.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initBlogListing } from "@/scripts/blog-listing";

  initBlogListing();
</script>
