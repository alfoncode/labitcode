---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/consts";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
  return tags.map((tag) => ({
    params: { tag: encodeURIComponent(tag) },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const decodedTag = decodeURIComponent(tag as string);
---

<BaseLayout
  title={`${decodedTag} Articles`}
  description={`Engineering articles tagged "${decodedTag}" on labitcode — Software Engineering, AI, Security, and DevOps.`}
  canonicalOverride={`${SITE}/blog/tag/${encodeURIComponent(tag)}`}
  breadcrumbs={[
    { name: "Home", url: SITE },
    { name: "Blog", url: `${SITE}/blog` },
    { name: decodedTag, url: `${SITE}/blog/tag/${encodeURIComponent(tag)}` },
  ]}
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-accent transition-colors mb-4"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
        >
        All Posts
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy dark:text-gray-100 tracking-tight">
        #{decodedTag}
      </h1>
      <p class="mt-2 text-gray-500 max-w-2xl">
        {posts.length} article{posts.length === 1 ? "" : "s"} tagged with "{decodedTag}".
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            author={post.data.author}
            slug={post.id}
            body={post.body}
            heroImage={post.data.heroImage}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
