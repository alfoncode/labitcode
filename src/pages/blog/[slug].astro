---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/Badge.astro";
import BlogCard from "@/components/BlogCard.astro";
import DiscussionCTA from "@/components/DiscussionCTA.astro";
import SocialShare from "@/components/SocialShare.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import Mermaid from "@/components/Mermaid.astro";
import { getCollection, render } from "astro:content";
import { formatDate, getReadingTime } from "@/utils/helpers";
import { getImageSize } from "@/utils/images";
import { SITE } from "@/consts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = post.body ? getReadingTime(post.body) : "3 min read";
const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;

// Related posts (share at least one tag, excluding current)
const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.tags.some((t) => post.data.tags.includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const ogImageRel = post.data.ogImage || post.data.heroImage || "/og-default.png";
const ogDims =
  post.data.heroImage || post.data.ogImage
    ? await getImageSize(post.data.ogImage || post.data.heroImage!)
    : { width: 1200, height: 630 };

const canonicalURL = post.data.canonicalURL || `${SITE}/blog/${post.id}`;

// JSON-LD for BlogPosting & TechArticle
const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: "en-US",
  wordCount,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author:
    post.data.author === "AI"
      ? { "@type": "Organization", name: "labitcode AI", url: SITE }
      : {
          "@type": "Person",
          name: post.data.author,
          url: SITE,
          sameAs: [
            "https://github.com/alfoncode",
            "https://www.linkedin.com/in/alfonsojosegarcia/",
          ],
        },
  publisher: {
    "@type": "Organization",
    name: "labitcode",
    url: SITE,
    logo: {
      "@type": "ImageObject",
      url: `${SITE}/og-default.png`,
      width: 1200,
      height: 630,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
  isPartOf: { "@type": "WebPage", "@id": `${SITE}/blog` },
  keywords: post.data.tags.join(", "),
  image: {
    "@type": "ImageObject",
    url: new URL(ogImageRel, SITE).href,
    width: ogDims.width,
    height: ogDims.height,
    ...(post.data.heroImageAlt && { caption: post.data.heroImageAlt }),
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImageRel}
  imageWidth={ogDims.width}
  imageHeight={ogDims.height}
  imageAlt={post.data.heroImageAlt || post.data.title}
  type="article"
  publishedDate={post.data.pubDate.toISOString()}
  modifiedDate={(post.data.updatedDate || post.data.pubDate).toISOString()}
  author={post.data.author}
  tags={post.data.tags}
  section="Blog"
  jsonLd={blogPostingLd}
  canonicalOverride={canonicalURL}
  breadcrumbs={[
    { name: "Home", url: SITE },
    { name: "Blog", url: `${SITE}/blog` },
    { name: post.data.title, url: `${SITE}/blog/${post.id}` },
  ]}
>
  <ReadingProgress />
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Back link -->
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-accent transition-colors mb-8"
    >
      <svg
        class="w-4 h-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
      >
      Back to Blog
    </a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map((tag: string) => <Badge label={tag} variant="accent" />)}
      </div>

      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy dark:text-gray-100 tracking-tight leading-[1.15] mb-4"
      >
        {post.data.title}
      </h1>

      <p class="text-lg text-gray-500 mb-6 max-w-none">
        {post.data.description}
      </p>

      <div
        class="flex items-center gap-4 text-sm text-gray-500 border-t border-border dark:border-navy-light pt-4"
      >
        <!-- Author avatar -->
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center text-accent text-xs font-bold"
          >
            {post.data.author === "AI" ? "AI" : "AG"}
          </div>
          <span class="font-medium text-navy dark:text-gray-100">{post.data.author}</span>
        </div>
        <span class="text-border dark:text-navy-light">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span class="text-border dark:text-navy-light">·</span>
        <span>{readingTime}</span>
      </div>

      <SocialShare
        title={post.data.title}
        url={`${SITE}/blog/${post.id}`}
        description={post.data.description}
      />
    </header>

    {/* Hero Image */}
    {
      post.data.heroImage && (
        <div class="mb-10 rounded-2xl overflow-hidden border border-border dark:border-navy-light aspect-video">
          <img
            src={post.data.heroImage}
            alt={post.data.heroImageAlt || post.data.title}
            class="w-full h-full object-cover"
            width="640"
            height="360"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <!-- Content -->
    <div class="prose max-w-none">
      <Content />
    </div>

    <Mermaid />

    <DiscussionCTA title={post.data.title} url={`${SITE}/blog/${post.id}`} />

    {
      relatedPosts.length > 0 && (
        <section class="mt-16 pt-8 border-t border-border dark:border-navy-light">
          <h2 class="text-2xl font-bold text-navy dark:text-gray-100 mb-6">Related Posts</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedPosts.map((p) => (
              <BlogCard
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
                author={p.data.author}
                slug={p.id}
                body={p.body}
                heroImage={p.data.heroImage}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-border dark:border-navy-light">
      <div class="flex items-center justify-between">
        <a
          href="/blog"
          class="text-sm font-medium text-accent hover:text-accent-light transition-colors flex items-center gap-1"
        >
          <svg
            class="w-4 h-4"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
          >
          All Posts
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  const LANG_LABELS: Record<string, string> = {
    typescript: "TypeScript",
    ts: "TypeScript",
    javascript: "JavaScript",
    js: "JavaScript",
    python: "Python",
    py: "Python",
    rust: "Rust",
    go: "Go",
    bash: "Bash",
    sh: "Shell",
    css: "CSS",
    html: "HTML",
    json: "JSON",
    yaml: "YAML",
    sql: "SQL",
    graphql: "GraphQL",
    markdown: "Markdown",
    md: "Markdown",
    tsx: "TSX",
    jsx: "JSX",
    astro: "Astro",
    svelte: "Svelte",
    dockerfile: "Dockerfile",
    toml: "TOML",
    xml: "XML",
  };

  function enhanceCodeBlocks(): void {
    const proseEls = document.querySelectorAll(".prose");
    proseEls.forEach((prose) => {
      const preBlocks = prose.querySelectorAll<HTMLPreElement>(":scope > pre");
      preBlocks.forEach((pre) => {
        // Skip already enhanced
        if (pre.parentElement?.classList.contains("code-block-wrapper")) return;

        // Skip mermaid blocks — handled by Mermaid.astro
        if (pre.getAttribute("data-language") === "mermaid") return;

        // Detect language from Shiki's data-language attribute
        const codeEl = pre.querySelector("code");
        const lang = pre.getAttribute("data-language") || "";
        const langLabel =
          LANG_LABELS[lang] || (lang ? lang.charAt(0).toUpperCase() + lang.slice(1) : "Code");

        // Build wrapper
        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper";

        // Header
        const header = document.createElement("div");
        header.className = "code-block-header";

        const langSpan = document.createElement("span");
        langSpan.className = "code-lang";
        langSpan.textContent = langLabel;

        const copyBtn = document.createElement("button");
        copyBtn.className = "code-copy-btn";
        copyBtn.type = "button";
        copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg><span>Copy</span>`;

        copyBtn.addEventListener("click", async () => {
          const text = codeEl?.textContent || pre.textContent || "";
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add("copied");
            const label = copyBtn.querySelector("span")!;
            label.textContent = "Copied!";
            setTimeout(() => {
              copyBtn.classList.remove("copied");
              label.textContent = "Copy";
            }, 2000);
          } catch {
            /* clipboard API might fail in insecure context */
          }
        });

        header.appendChild(langSpan);
        header.appendChild(copyBtn);

        // Assemble
        pre.parentNode!.insertBefore(wrapper, pre);
        wrapper.appendChild(header);
        wrapper.appendChild(pre);
      });
    });
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:after-swap", enhanceCodeBlocks);
</script>
