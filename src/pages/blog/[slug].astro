---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/Badge.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, getReadingTime } from '@/utils/helpers';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = post.body ? getReadingTime(post.body) : '3 min read';

// JSON-LD for BlogPosting
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': post.data.author === 'AI' ? 'Organization' : 'Person',
    name: post.data.author === 'AI' ? 'labitcode AI' : post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'labitcode',
    url: 'https://labitcode.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://labitcode.com/blog/${post.id}`,
  },
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.pubDate.toISOString()}
  modifiedDate={(post.data.updatedDate || post.data.pubDate).toISOString()}
  author={post.data.author}
  tags={post.data.tags}
  jsonLd={blogPostingLd}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Back link -->
    <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-accent transition-colors mb-8">
      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
      Back to Blog
    </a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map((tag: string) => (
          <Badge label={tag} variant="accent" />
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy dark:text-gray-100 tracking-tight leading-[1.15] mb-4">
        {post.data.title}
      </h1>

      <p class="text-lg text-gray-500 mb-6 max-w-2xl">
        {post.data.description}
      </p>

      <div class="flex items-center gap-4 text-sm text-gray-500 border-t border-border dark:border-navy-light pt-4">
        <!-- Author avatar -->
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center text-accent text-xs font-bold">
            {post.data.author === 'AI' ? 'AI' : 'AG'}
          </div>
          <span class="font-medium text-navy dark:text-gray-100">{post.data.author}</span>
        </div>
        <span class="text-border dark:text-navy-light">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span class="text-border dark:text-navy-light">·</span>
        <span>{readingTime}</span>
      </div>
    </header>

    <!-- Content -->
    <div class="prose">
      <Content />
    </div>

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-border dark:border-navy-light">
      <div class="flex items-center justify-between">
        <a href="/blog" class="text-sm font-medium text-accent hover:text-accent-light transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          All Posts
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  const LANG_LABELS: Record<string, string> = {
    typescript: 'TypeScript', ts: 'TypeScript',
    javascript: 'JavaScript', js: 'JavaScript',
    python: 'Python', py: 'Python',
    rust: 'Rust', go: 'Go', bash: 'Bash', sh: 'Shell',
    css: 'CSS', html: 'HTML', json: 'JSON', yaml: 'YAML',
    sql: 'SQL', graphql: 'GraphQL', markdown: 'Markdown', md: 'Markdown',
    tsx: 'TSX', jsx: 'JSX', astro: 'Astro', svelte: 'Svelte',
    dockerfile: 'Dockerfile', toml: 'TOML', xml: 'XML',
  };

  function enhanceCodeBlocks(): void {
    const proseEls = document.querySelectorAll('.prose');
    proseEls.forEach((prose) => {
      const preBlocks = prose.querySelectorAll<HTMLPreElement>(':scope > pre');
      preBlocks.forEach((pre) => {
        // Skip already enhanced
        if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

        // Detect language from Shiki's data-language attribute
        const codeEl = pre.querySelector('code');
        const lang = pre.getAttribute('data-language') || '';
        const langLabel = LANG_LABELS[lang] || (lang ? lang.charAt(0).toUpperCase() + lang.slice(1) : 'Code');

        // Build wrapper
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';

        // Header
        const header = document.createElement('div');
        header.className = 'code-block-header';

        const langSpan = document.createElement('span');
        langSpan.className = 'code-lang';
        langSpan.textContent = langLabel;

        const copyBtn = document.createElement('button');
        copyBtn.className = 'code-copy-btn';
        copyBtn.type = 'button';
        copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg><span>Copy</span>`;

        copyBtn.addEventListener('click', async () => {
          const text = codeEl?.textContent || pre.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add('copied');
            const label = copyBtn.querySelector('span')!;
            label.textContent = 'Copied!';
            setTimeout(() => {
              copyBtn.classList.remove('copied');
              label.textContent = 'Copy';
            }, 2000);
          } catch { /* clipboard API might fail in insecure context */ }
        });

        header.appendChild(langSpan);
        header.appendChild(copyBtn);

        // Assemble
        pre.parentNode!.insertBefore(wrapper, pre);
        wrapper.appendChild(header);
        wrapper.appendChild(pre);
      });
    });
  }

  enhanceCodeBlocks();
  document.addEventListener('astro:after-swap', enhanceCodeBlocks);
</script>

