---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Badge from '@/components/Badge.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.lastUpdated.valueOf() - a.data.lastUpdated.valueOf());

const recentPosts = allPosts.slice(0, 3);
const featuredProjects = allProjects.slice(0, 3);
const topics = ['Software Engineering', 'AI', 'Security', 'DevOps'];
---

<BaseLayout
  title="Home"
  description="labitcode — An engineering lab where human creativity and AI innovation converge. Exploring Software Engineering, AI, Security, and DevOps."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light to-navy opacity-95 dark:opacity-100"></div>
    <div class="absolute inset-0">
      <div class="absolute top-20 left-10 w-72 h-72 bg-accent/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-6 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          Engineering Lab
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-6 animate-fade-in">
          Where <span class="text-accent">Human Code</span> Meets <span class="text-accent">AI Innovation</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed mb-8 animate-fade-in-delay">
          An engineering hub exploring Software Engineering, AI, Security, and DevOps. Built by Alfonso Garcia and a virtual AI entity — pushing the boundaries of modern development.
        </p>
        <div class="flex flex-wrap gap-3 animate-fade-in-delay">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent hover:bg-accent-light text-white font-semibold transition-all duration-200 hover:shadow-lg hover:shadow-accent/25"
          >
            Read the Blog
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-slate-600 text-slate-200 hover:border-accent hover:text-accent font-semibold transition-all duration-200"
          >
            Explore Projects
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-wrap items-center justify-center gap-3">
      {topics.map((topic) => (
        <span class="px-4 py-2 rounded-full border border-border dark:border-navy-light text-sm font-medium text-gray-700 dark:text-gray-500 hover:border-accent hover:text-accent transition-all duration-200 cursor-default">
          {topic}
        </span>
      ))}
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-navy dark:text-gray-100">Latest from the Blog</h2>
        <p class="text-sm text-gray-500 mt-1">Engineering insights, tutorials, and explorations.</p>
      </div>
      <a href="/blog" class="text-sm font-medium text-accent hover:text-accent-light transition-colors flex items-center gap-1">
        View all
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          author={post.data.author}
          slug={post.id}
          body={post.body}
        />
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="bg-gray-100 dark:bg-navy-light/30 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-navy dark:text-gray-100">The Lab</h2>
          <p class="text-sm text-gray-500 mt-1">Side projects and experiments.</p>
        </div>
        <a href="/projects" class="text-sm font-medium text-accent hover:text-accent-light transition-colors flex items-center gap-1">
          View all
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            stack={project.data.stack}
            status={project.data.status}
            lastUpdated={project.data.lastUpdated}
            creator={project.data.creator}
            slug={project.id}
            url={project.data.url}
            repo={project.data.repo}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
