---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Team"
  description="Meet the labitcode team — Alfonso Garcia and our virtual AI entity, pushing the boundaries of software engineering together."
  type="profile"
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy dark:text-gray-100 tracking-tight">
        About Us
      </h1>
      <p class="mt-2 text-gray-500 max-w-2xl">
        labitcode is built on the synergy between human expertise and AI capability — a team where both bring unique strengths to engineering.
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Alfonso Garcia -->
      <article class="rounded-2xl border border-border dark:border-navy-light bg-surface dark:bg-navy-light/50 p-8 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-accent to-accent-dark flex items-center justify-center text-white text-xl font-bold shrink-0">
            AG
          </div>
          <div>
            <h2 class="text-xl font-bold text-navy dark:text-gray-100">Alfonso Garcia</h2>
            <p class="text-accent font-medium text-sm">Software Engineer</p>
          </div>
        </div>
        <p class="text-gray-700 dark:text-gray-500 leading-relaxed mb-6">
          Software Engineer specializing in backend systems, CI/CD pipelines, and developer tooling. Expert in Santander banking systems and GitHub Actions automation. Alfonso brings deep engineering experience across financial services and open-source development.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Backend</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">CI/CD</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">GitHub Actions</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Security</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">DevOps</span>
        </div>
        <div class="flex gap-3 mt-6 pt-6 border-t border-border dark:border-navy-light">
          <a href="https://github.com/labitcode" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-accent hover:text-accent-light transition-colors">
            GitHub ↗
          </a>
        </div>
      </article>

      <!-- AI Entity -->
      <article class="rounded-2xl border border-border dark:border-navy-light bg-surface dark:bg-navy-light/50 p-8 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-navy-light to-navy dark:from-accent/20 dark:to-accent/5 flex items-center justify-center text-accent text-xl font-bold shrink-0 border border-accent/20">
            AI
          </div>
          <div>
            <h2 class="text-xl font-bold text-navy dark:text-gray-100">Virtual AI Entity</h2>
            <p class="text-accent font-medium text-sm">AI Engineering Partner</p>
          </div>
        </div>
        <p class="text-gray-700 dark:text-gray-500 leading-relaxed mb-6">
          A core team member representing the synergy between human and AI development. The AI entity assists with code generation, architectural design, technical writing, security analysis, and research — augmenting Alfonso's engineering capabilities across every project.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Code Generation</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Architecture</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Technical Writing</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Research</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-navy text-gray-700 dark:text-gray-500">Security Analysis</span>
        </div>
        <div class="flex gap-3 mt-6 pt-6 border-t border-border dark:border-navy-light">
          <span class="text-sm text-gray-500 italic">Always online, always learning.</span>
        </div>
      </article>
    </div>

    <!-- Mission -->
    <div class="mt-16 rounded-2xl bg-gradient-to-br from-navy via-navy-light to-navy p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">Our Mission</h2>
      <p class="text-slate-300 max-w-2xl mx-auto leading-relaxed text-lg">
        To explore the intersection of human engineering skill and AI capability — building tools, sharing knowledge, and pushing the boundaries of what's possible in modern software development.
      </p>
    </div>
  </section>
</BaseLayout>
