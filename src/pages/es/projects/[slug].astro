---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/Badge.astro";
import DiscussionCTA from "@/components/DiscussionCTA.astro";
import SocialShare from "@/components/SocialShare.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "@/utils/helpers";
import { getImageSize } from "@/utils/images";
import { SITE } from "@/consts";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => project.data.lang === "es")
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const heroImage = project.data.heroImage || "/og-default.png";
const ogDims = project.data.heroImage
  ? await getImageSize(project.data.heroImage)
  : { width: 1200, height: 630 };

const isArchived = project.data.status === "archived";

const statusColors: Record<string, string> = {
  active: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
  "in-progress": "bg-amber-500/10 text-amber-600 dark:text-amber-400",
  archived: "bg-gray-500/10 text-gray-500",
};

const statusLabels: Record<string, string> = {
  active: "activo",
  "in-progress": "en desarrollo",
  archived: "archivado",
};

const alternateUrls = {
  en: project.data.translationSlug
    ? `${SITE}/projects/${project.data.translationSlug}`
    : `${SITE}/projects`,
  es: `${SITE}/es/projects/${project.id}`,
};

// JSON-LD for SoftwareApplication in Spanish
const softwareAppLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.data.title,
  description: project.data.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  inLanguage: "es-ES",
  author: { "@type": "Person", name: project.data.creator },
  ...(project.data.url && { url: project.data.url }),
  ...(project.data.repo && { codeRepository: project.data.repo }),
  ...(project.data.heroImage && {
    image: {
      "@type": "ImageObject",
      url: new URL(project.data.heroImage, SITE).href,
      width: ogDims.width,
      height: ogDims.height,
    },
  }),
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={heroImage}
  imageWidth={ogDims.width}
  imageHeight={ogDims.height}
  imageAlt={project.data.title}
  type="article"
  author={project.data.creator}
  section="Projects"
  jsonLd={softwareAppLd}
  canonicalOverride={`${SITE}/es/projects/${project.id}`}
  noindex={isArchived}
  lang="es"
  alternateUrls={alternateUrls}
  breadcrumbs={[
    { name: "Inicio", url: `${SITE}/es` },
    { name: "Proyectos", url: `${SITE}/es/projects` },
    { name: project.data.title, url: `${SITE}/es/projects/${project.id}` },
  ]}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
      <!-- Back link -->
      <a
        href="/es/projects"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-accent transition-colors"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
        >
        Volver a Proyectos
      </a>

      {
        project.data.translationSlug && (
          <a
            href={`/projects/${project.data.translationSlug}`}
            class="lang-switch-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent/10 border border-accent/20 text-accent text-xs font-semibold hover:bg-accent/20 transition-colors"
            data-target-lang="en"
          >
            <span>🇬🇧 View in English</span>
            <svg
              class="w-3.5 h-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        )
      }
    </div>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div
          class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent shrink-0"
        >
          <svg
            class="w-6 h-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
            ></path>
          </svg>
        </div>
        <span
          class:list={[
            "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium",
            statusColors[project.data.status] || statusColors.active,
          ]}
        >
          {statusLabels[project.data.status] || project.data.status}
        </span>
      </div>

      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy dark:text-gray-100 tracking-tight leading-[1.15] mb-4"
      >
        {project.data.title}
      </h1>

      <p class="text-lg text-gray-500 mb-6 max-w-none">
        {project.data.description}
      </p>

      <!-- Stack -->
      <div class="flex flex-wrap gap-2 mb-6">
        {project.data.stack.map((tech: string) => <Badge label={tech} variant="accent" />)}
      </div>

      <!-- Links & Metadata -->
      <div
        class="flex flex-wrap items-center gap-4 text-sm text-gray-500 border-t border-border dark:border-navy-light pt-4"
      >
        <span>Por <strong class="text-navy dark:text-gray-100">{project.data.creator}</strong></span
        >
        <span class="text-border dark:text-navy-light">·</span>
        <span>Actualizado {formatDate(project.data.lastUpdated, "es")}</span>

        <div class="ml-auto flex items-center gap-3">
          {
            project.data.url && (
              <a
                href={project.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-lg bg-accent text-white hover:bg-accent/90 transition-colors"
              >
                <span>Ver demo</span>
                <svg
                  class="w-4 h-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
                </svg>
              </a>
            )
          }
          {
            project.data.repo && (
              <a
                href={project.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-lg border border-border dark:border-navy-light text-navy dark:text-gray-100 hover:text-accent hover:border-accent transition-colors"
              >
                <span>Repositorio</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
              </a>
            )
          }
        </div>
      </div>

      <SocialShare
        title={project.data.title}
        url={`${SITE}/es/projects/${project.id}`}
        description={project.data.description}
        lang="es"
      />
    </header>

    {/* Hero Image */}
    {
      project.data.heroImage && (
        <div class="mb-10 rounded-2xl overflow-hidden border border-border dark:border-navy-light aspect-video">
          <img
            src={project.data.heroImage}
            alt={project.data.title}
            class="w-full h-full object-cover"
            width="640"
            height="360"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <!-- Content -->
    <div class="prose max-w-none">
      <Content />
    </div>

    <DiscussionCTA title={project.data.title} url={`${SITE}/es/projects/${project.id}`} lang="es" />

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-border dark:border-navy-light">
      <div class="flex items-center justify-between">
        <a
          href="/es/projects"
          class="text-sm font-medium text-accent hover:text-accent-light transition-colors flex items-center gap-1"
        >
          <svg
            class="w-4 h-4"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
          >
          Volver a Proyectos
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
