---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchBar from "@/components/SearchBar.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/consts";

const ITEMS_PER_PAGE = 6;

const allSpanishProjects = (await getCollection("projects"))
  .filter((p) => p.data.lang === "es")
  .sort((a, b) => b.data.lastUpdated.valueOf() - a.data.lastUpdated.valueOf());

// If few Spanish projects exist, fallback to all projects for rich display
const fallbackProjects = (await getCollection("projects"))
  .filter((p) => p.data.lang !== "es")
  .sort((a, b) => b.data.lastUpdated.valueOf() - a.data.lastUpdated.valueOf());

const displayProjects = allSpanishProjects.length > 0 ? allSpanishProjects : fallbackProjects;

// ItemList JSON-LD
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "labitcode Proyectos (Español)",
  url: `${SITE}/es/projects`,
  itemListElement: displayProjects.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE}/es/projects/${p.id}`,
    name: p.data.title,
  })),
};
---

<BaseLayout
  title="Proyectos"
  description="El Laboratorio — Proyectos paralelos y experimentos de labitcode, explorando nuevas tecnologías y patrones de ingeniería."
  lang="es"
  alternateUrls={{ en: `${SITE}/projects`, es: `${SITE}/es/projects` }}
  jsonLd={itemListLd}
  breadcrumbs={[
    { name: "Inicio", url: `${SITE}/es` },
    { name: "Proyectos", url: `${SITE}/es/projects` },
  ]}
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy dark:text-gray-100 tracking-tight">
        El Laboratorio
      </h1>
      <p class="mt-2 text-gray-500 max-w-2xl">
        Proyectos paralelos, experimentos y herramientas creadas para explorar nuevas ideas y
        expandir los límites del desarrollo moderno.
      </p>
    </div>

    <!-- Search Bar -->
    <SearchBar
      placeholder="Buscar proyectos por título, descripción o stack tecnológico…"
      inputId="projects-search"
    />

    <!-- Results count -->
    <p id="results-count" class="text-sm text-gray-500 mb-4">
      Mostrando {Math.min(ITEMS_PER_PAGE, displayProjects.length)} de {displayProjects.length} proyectos
    </p>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {
        displayProjects.map((project, i) => {
          const searchText =
            `${project.data.title} ${project.data.description} ${project.data.stack.join(" ")}`.toLowerCase();
          return (
            <div
              data-stack={JSON.stringify(project.data.stack)}
              data-search-text={searchText}
              class:list={[
                "project-card h-full transition-all duration-300",
                { hidden: i >= ITEMS_PER_PAGE },
              ]}
            >
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                stack={project.data.stack}
                status={project.data.status}
                lastUpdated={project.data.lastUpdated}
                creator={project.data.creator}
                slug={project.id}
                url={project.data.url}
                repo={project.data.repo}
                heroImage={project.data.heroImage}
                lang="es"
              />
            </div>
          );
        })
      }
    </div>

    <!-- Empty state -->
    <div id="no-projects" class="hidden py-16 text-center text-gray-500">
      <svg
        class="w-12 h-12 mx-auto mb-4 text-gray-500"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"
        ></path>
      </svg>
      <p class="text-lg font-medium text-navy dark:text-gray-200">No se encontraron proyectos</p>
      <p class="text-sm mt-1">Prueba a buscar con otros términos o tecnología.</p>
    </div>

    <!-- Infinite Scroll Sentinel -->
    <div id="scroll-sentinel" class="py-8 flex flex-col items-center justify-center">
      <div id="scroll-spinner" class="hidden flex items-center gap-2 text-sm text-gray-500">
        <svg
          class="animate-spin w-5 h-5 text-accent"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
          ></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
        <span>Cargando más proyectos…</span>
      </div>
      <p id="scroll-end" class="text-sm text-gray-500 hidden">Has llegado al final</p>
    </div>
  </section>
</BaseLayout>

<script>
  const ITEMS_PER_PAGE = 6;
  let searchQuery = "";
  let visibleCount = ITEMS_PER_PAGE;

  const grid = document.getElementById("projects-grid")!;
  const cards = Array.from(grid?.querySelectorAll<HTMLElement>(".project-card") || []);
  const searchInput = document.getElementById("projects-search") as HTMLInputElement;
  const clearBtn = document.getElementById("projects-search-clear");
  const noProjectsEl = document.getElementById("no-projects");
  const sentinel = document.getElementById("scroll-sentinel");
  const spinner = document.getElementById("scroll-spinner");
  const endMsg = document.getElementById("scroll-end");
  const resultsCount = document.getElementById("results-count");

  function cardMatchesSearch(card: HTMLElement): boolean {
    if (!searchQuery.trim()) return true;
    const text = card.dataset.searchText || "";
    return text.includes(searchQuery.toLowerCase().trim());
  }

  function updateVisibility(): void {
    let matchCount = 0;
    let shownCount = 0;

    cards.forEach((card) => {
      const matches = cardMatchesSearch(card);

      if (matches) {
        matchCount++;
        if (shownCount < visibleCount) {
          card.classList.remove("hidden");
          shownCount++;
        } else {
          card.classList.add("hidden");
        }
      } else {
        card.classList.add("hidden");
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `Mostrando ${shownCount} de ${matchCount} proyectos`;
    }

    noProjectsEl?.classList.toggle("hidden", matchCount > 0);

    const hasMore = shownCount < matchCount;
    spinner?.classList.toggle("hidden", !hasMore);
    endMsg?.classList.toggle("hidden", hasMore || matchCount === 0);
    sentinel?.classList.toggle("hidden", matchCount === 0);
  }

  function loadMore(): void {
    visibleCount += ITEMS_PER_PAGE;
    updateVisibility();
  }

  let observer: IntersectionObserver | null = null;

  function setupObserver(): void {
    if (observer) observer.disconnect();
    if (!sentinel) return;

    observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          loadMore();
        }
      },
      { rootMargin: "200px" }
    );
    observer.observe(sentinel);
  }

  function setupSearch(): void {
    if (!searchInput) return;

    searchInput.addEventListener("input", () => {
      searchQuery = searchInput.value;
      visibleCount = ITEMS_PER_PAGE;
      clearBtn?.classList.toggle("hidden", !searchQuery);
      updateVisibility();
    });

    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      searchQuery = "";
      visibleCount = ITEMS_PER_PAGE;
      clearBtn.classList.add("hidden");
      searchInput.focus();
      updateVisibility();
    });
  }

  setupSearch();
  setupObserver();
</script>
