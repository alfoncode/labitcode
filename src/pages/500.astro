---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="500: Server Error" description="Internal server error" noindex>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h1 class="text-4xl sm:text-5xl font-extrabold text-navy dark:text-gray-100 mb-4">500</h1>
    <p class="text-xl text-gray-500 mb-8">
      Internal server error. Something went wrong on our end.
    </p>
    <a
      href="/"
      class="px-6 py-3 bg-accent text-white rounded-lg font-medium hover:bg-accent-dark transition-colors"
      >Go Home</a
    >
  </section>
</BaseLayout>
